# Local dev: frontend (port 3000) and backend (port 5000) run separately, so point
# this at the local backend directly.
#   NEXT_PUBLIC_API_URL=http://localhost:5000/api
#
# Production on Vercel (single combined deployment, see root vercel.json): frontend
# and backend are served from the same domain, so you can leave this UNSET — lib/api.js
# already falls back to the relative path "/api", which routes to the backend via
# vercel.json's rewrite. Only set it if you deploy the backend somewhere separate.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Used for SEO metadata, sitemap, and canonical URLs — set to your real production domain.
NEXT_PUBLIC_SITE_URL=https://ajwasweets.example.com
