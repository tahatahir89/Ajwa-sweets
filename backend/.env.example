MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Set this to your deployed site's URL once you have it (used for CORS).
# In the combined single-deployment setup, frontend and backend share one
# domain, so this mostly matters for local dev / any cross-origin admin use.
CLIENT_URL=http://localhost:3000

# Used by /api/settings so the frontend's WhatsApp button/links work without
# a hardcoded number in the frontend code.
WHATSAPP_NUMBER=923001234567

# Cloudinary (free tier) — used for product image uploads in the admin panel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo SMTP relay — sends order status-update emails to customers.
# Get these from Brevo dashboard → SMTP & API → SMTP tab (NOT the API Keys tab —
# that's a different credential type this project doesn't use).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_smtp_login@smtp-brevo.com
BREVO_SMTP_PASSWORD=your_smtp_key

# The "from" address customers see — must be a verified sender in Brevo
# (Senders, Domains & Dedicated IPs → Senders) or sends will be rejected.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ajwa Sweets & Bakers

# Created by `npm run seed` — first admin account.
ADMIN_EMAIL=admin@ajwasweets.com
ADMIN_PASSWORD=change_this_password

PORT=5000
